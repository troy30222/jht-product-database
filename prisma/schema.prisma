generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  admin
  manager
  marketing
  sales
  viewer
}

enum ProductStatus {
  draft
  active
  upcoming
  discontinued
}

enum LifecycleStage {
  new
  mature
  legacy
  discontinued
}

enum SpecDataType {
  text
  number
  boolean
  option
  range
  dimension
  json
}

enum CompareType {
  higher_is_better
  lower_is_better
  neutral
  text_only
  range_compare
  dimension_compare
}

enum ImageType {
  cover
  gallery
  lifestyle
  spec
  comparison
}

enum ImportStatus {
  uploaded
  previewed
  mapped
  validating
  completed
  failed
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  passwordHash     String?
  role             UserRole          @default(viewer)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  auditLogs        AuditLog[]
  importJobs       ImportJob[]
  savedComparisons SavedComparison[]
}

model Brand {
  id                   String    @id @default(cuid())
  name                 String    @unique
  displayName          String
  description          String?   @db.Text
  tier                 String?
  positioningStatement String?   @db.Text
  coreValue            String?   @db.Text
  productStrength      String?   @db.Text
  productWeakness      String?   @db.Text
  salesAngle           String?   @db.Text
  marketingAngle       String?   @db.Text
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  products             Product[]
}

model Category {
  id            String         @id @default(cuid())
  name          String         @unique
  displayName   String
  description   String?        @db.Text
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subcategories Subcategory[]
  products      Product[]
  specTemplates SpecTemplate[]
  priceBands    PriceBand[]
}

model Subcategory {
  id            String         @id @default(cuid())
  categoryId    String
  name          String
  displayName   String
  description   String?        @db.Text
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products      Product[]
  specTemplates SpecTemplate[]
  priceBands    PriceBand[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Product {
  id                String              @id @default(cuid())
  brandId           String
  categoryId        String
  subcategoryId     String?
  specTemplateId    String?
  priceBandId       String?
  seriesName        String?
  modelName         String
  modelCode         String?
  slug              String              @unique
  shortDescription  String?             @db.Text
  longDescription   String?             @db.Text
  status            ProductStatus       @default(draft)
  lifecycleStage    LifecycleStage      @default(new)
  market            String              @default("TW")
  currency          String              @default("TWD")
  msrp              Decimal?            @db.Decimal(12, 2)
  dealerPrice       Decimal?            @db.Decimal(12, 2)
  launchDate        DateTime?
  discontinuedDate  DateTime?
  targetCustomer    String?
  useCase           String?             @db.Text
  positioningTier   String?
  machineFunction   String?
  internalNote      String?             @db.Text
  completenessScore Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  brand             Brand               @relation(fields: [brandId], references: [id])
  category          Category            @relation(fields: [categoryId], references: [id])
  subcategory       Subcategory?        @relation(fields: [subcategoryId], references: [id])
  specTemplate      SpecTemplate?       @relation(fields: [specTemplateId], references: [id])
  priceBand         PriceBand?          @relation(fields: [priceBandId], references: [id])
  images            ProductImage[]
  specValues        ProductSpecValue[]
  features          ProductFeature[]
  marketingContent  MarketingContent?
  salesContent      SalesContent?

  @@index([brandId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([market])
  @@index([machineFunction])
  @@index([modelName])
  @@index([modelCode])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  url       String
  altText   String?
  imageType ImageType @default(gallery)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SpecTemplate {
  id            String                  @id @default(cuid())
  name          String
  key           String                  @unique
  categoryId    String
  subcategoryId String?
  description   String?                 @db.Text
  sortOrder     Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  category      Category                @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory?            @relation(fields: [subcategoryId], references: [id])
  attributes    SpecTemplateAttribute[]
  products      Product[]

  @@index([categoryId])
  @@index([subcategoryId])
}

model SpecTemplateAttribute {
  id              String        @id @default(cuid())
  specTemplateId  String
  specAttributeId String
  isRequired      Boolean       @default(false)
  isCoreSpec      Boolean       @default(false)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  specTemplate    SpecTemplate  @relation(fields: [specTemplateId], references: [id], onDelete: Cascade)
  specAttribute   SpecAttribute @relation(fields: [specAttributeId], references: [id], onDelete: Cascade)

  @@unique([specTemplateId, specAttributeId])
  @@index([specAttributeId])
}

model SpecAttribute {
  id                 String                  @id @default(cuid())
  name               String
  key                String                  @unique
  groupName          String?
  description        String?                 @db.Text
  dataType           SpecDataType
  unit               String?
  isCoreSpec         Boolean                 @default(false)
  isComparable       Boolean                 @default(false)
  compareType        CompareType             @default(neutral)
  compareWeight      Int                     @default(0)
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  aliases            SpecAlias[]
  templateAttributes SpecTemplateAttribute[]
  productValues      ProductSpecValue[]
}

model SpecAlias {
  id                  String        @id @default(cuid())
  specAttributeId     String
  aliasName           String
  normalizedAliasName String
  createdAt           DateTime      @default(now())
  specAttribute       SpecAttribute @relation(fields: [specAttributeId], references: [id], onDelete: Cascade)

  @@unique([specAttributeId, normalizedAliasName])
  @@index([normalizedAliasName])
}

model ProductSpecValue {
  id              String        @id @default(cuid())
  productId       String
  specAttributeId String
  rawValue        String?       @db.Text
  displayValue    String?       @db.Text
  valueText       String?       @db.Text
  valueNumber     Decimal?      @db.Decimal(12, 3)
  valueBoolean    Boolean?
  valueOption     String?
  normalizedValue Decimal?      @db.Decimal(12, 3)
  normalizedUnit  String?
  minValue        Decimal?      @db.Decimal(12, 3)
  maxValue        Decimal?      @db.Decimal(12, 3)
  lengthValue     Decimal?      @db.Decimal(12, 3)
  widthValue      Decimal?      @db.Decimal(12, 3)
  heightValue     Decimal?      @db.Decimal(12, 3)
  areaValue       Decimal?      @db.Decimal(14, 3)
  jsonValue       Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  specAttribute   SpecAttribute @relation(fields: [specAttributeId], references: [id], onDelete: Cascade)

  @@unique([productId, specAttributeId])
  @@index([productId])
  @@index([specAttributeId])
}

model ProductFeature {
  id          String  @id @default(cuid())
  productId   String
  title       String
  description String? @db.Text
  sortOrder   Int     @default(0)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model MarketingContent {
  id                      String   @id @default(cuid())
  productId               String   @unique
  oneLineSellingPoint     String?  @db.Text
  keySellingPoints        Json?
  targetAudience          String?  @db.Text
  unsuitableAudience      String?  @db.Text
  adCopy                  String?  @db.Text
  socialPostCopy          String?  @db.Text
  websiteShortDescription String?  @db.Text
  websiteLongDescription  String?  @db.Text
  edmCopy                 String?  @db.Text
  landingPageHighlights   Json?
  competitorCopy          String?  @db.Text
  updatedAt               DateTime @updatedAt
  product                 Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SalesContent {
  id                   String   @id @default(cuid())
  productId            String   @unique
  salesBrief           String?  @db.Text
  recommendationScript String?  @db.Text
  objectionHandling    String?  @db.Text
  sameBrandComparison  String?  @db.Text
  crossBrandComparison String?  @db.Text
  recommendedScenario  String?  @db.Text
  unsuitableScenario   String?  @db.Text
  faq                  Json?
  updatedAt            DateTime @updatedAt
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PriceBand {
  id              String       @id @default(cuid())
  name            String
  categoryId      String?
  subcategoryId   String?
  market          String       @default("TW")
  currency        String       @default("TWD")
  minPrice        Decimal      @db.Decimal(12, 2)
  maxPrice        Decimal      @db.Decimal(12, 2)
  positioningTier String?
  description     String?      @db.Text
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  category        Category?    @relation(fields: [categoryId], references: [id])
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id])
  products        Product[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([market])
}

model SavedComparison {
  id         String   @id @default(cuid())
  name       String
  userId     String
  productIds Json
  note       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entityType String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([userId])
}

model ImportJob {
  id         String       @id @default(cuid())
  userId     String
  fileName   String
  importType String
  status     ImportStatus @default(uploaded)
  summary    Json?
  errors     Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
